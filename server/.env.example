PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/sbn-kirana
# Use at least 64 random characters in production.
JWT_SECRET=replace_with_64_plus_random_characters
# Use a separate 64+ character random value. Existing encrypted KYC files depend on this key.
KYC_ENCRYPTION_KEY=replace_with_a_separate_64_plus_random_secret
ADMIN_NAME=SBN Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_unique_strong_admin_password
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
AUTO_SEED=false
NODE_ENV=development
